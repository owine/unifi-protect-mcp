UNIFI_PROTECT_HOST=192.168.1.1
UNIFI_PROTECT_API_KEY=your-api-key-here
UNIFI_PROTECT_VERIFY_SSL=false
# Write/mutating tools are only registered when this is false
UNIFI_PROTECT_READ_ONLY=true
# Cloud Connector only: set HOST to api.ui.com and supply the console ID
# UNIFI_PROTECT_CONSOLE_ID=your-console-id
