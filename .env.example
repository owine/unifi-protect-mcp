UNIFI_PROTECT_HOST=192.168.1.1
UNIFI_PROTECT_API_KEY=your-api-key-here
# A local console's self-signed certificate: save it and point this at the file
# (absolute path). See README "Self-signed console certificates".
# UNIFI_PROTECT_CA_CERT=/absolute/path/to/console.pem
# Last resort on a trusted network only; refused with api.ui.com or CA_CERT
# UNIFI_PROTECT_VERIFY_SSL=false
# Write tools are only registered when this is false
UNIFI_PROTECT_READ_ONLY=true
# Cloud Connector only: set HOST to api.ui.com and supply the console ID
# UNIFI_PROTECT_CONSOLE_ID=your-console-id
